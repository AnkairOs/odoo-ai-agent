# Server Configuration
PORT=3000

# Default Odoo 19 Configuration (Fallback if not provided per tenant)
ODOO_DEFAULT_URL=http://localhost:8069
ODOO_DEFAULT_DB=odoo
ODOO_DEFAULT_API_KEY=your_odoo_api_key_here

# Odoo connection diagnostic (GET /odoo/test-connection). Disabled unless exactly "true".
# Uses only the server-side Odoo configuration above; never enable it on a public endpoint.
ODOO_DIAGNOSTICS_ENABLED=false

# Kapso webhook secret_key, used to verify X-Webhook-Signature (hex HMAC-SHA256 of the raw body).
# Keep empty here: this file is loaded as a fallback, and an empty secret rejects every webhook.
# Set the real value only in .env.
KAPSO_WEBHOOK_SECRET=
